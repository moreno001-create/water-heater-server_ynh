#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression "Installing the app and its Python dependencies..."
_install_app
_setup_dirs

ynh_script_progression "Adding system configurations..."
ynh_config_add_nginx
ynh_config_add_systemd
yunohost service add "$app" --description="A. O. Smith water heater dashboard" --log="/var/log/$app/$app.log"
ynh_config_add_logrotate

ynh_script_progression "Starting $app's service..."
ynh_systemctl --service="$app" --action="start" --log_path="/var/log/$app/$app.log" --wait_until="Uvicorn running"

ynh_script_progression "Installation of $app completed"
