#!/bin/bash

source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

ynh_script_progression "Restoring the app and its data..."
ynh_restore "$install_dir"
chown -R "$app:www-data" "$install_dir"
chmod -R o-rwx "$install_dir"
ynh_restore "$data_dir"
_setup_dirs

ynh_script_progression "Restoring system configurations..."
ynh_restore "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_restore "/etc/systemd/system/$app.service"
systemctl enable "$app.service" --quiet
yunohost service add "$app" --description="A. O. Smith water heater dashboard" --log="/var/log/$app/$app.log"
ynh_restore "/etc/logrotate.d/$app"

ynh_script_progression "Reloading NGINX and starting $app..."
ynh_systemctl --service="$app" --action="start" --log_path="/var/log/$app/$app.log" --wait_until="Uvicorn running"
ynh_systemctl --service=nginx --action=reload

ynh_script_progression "Restoration completed for $app"
